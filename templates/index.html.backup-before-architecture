        </div>

    </main>


    <!-- ================= VIDÉOS ================= -->

    <main class="app-space" id="spaceVideos">

        <button
            class="space-back"
            data-space="home">
            ← Retour
        </button>

        <div class="space-screen-content">

            <span class="space-kicker">
                🎬 FOOTBALL VIDEOS
            </span>

            <h1>
                FOOT
                <span>VIDEOS</span>
            </h1>

            <p>
                Regarde les vidéos de la communauté,
                partage tes moments et découvre
                les tendances football.
            </p>

            <div class="space-actions">

                <button class="space-button primary">
                    ▶️ REGARDER
                </button>

                <button class="space-button">
                    ⬆️ PUBLIER UNE VIDÉO
                </button>

            </div>

        </div>

    </main>


    <!-- ================= ACTUALITÉS ================= -->

    <main class="app-space" id="spaceNews">

        <button
            class="space-back"
            data-space="home">
            ← Retour
        </button>

        <div class="space-screen-content">

            <span class="space-kicker">
                📰 WORLD FOOTBALL NEWS
            </span>

            <h1>
                FOOTBALL
                <span>NEWS</span>
            </h1>

            <p>
                Découvre les dernières actualités,
                publie tes informations et participe
                aux discussions.
            </p>

            <div class="space-actions">

                <button class="space-button primary">
                    📰 LIRE LES ACTUALITÉS
                </button>

                <button class="space-button">
                    ✍️ PUBLIER UNE ACTUALITÉ
                </button>

            </div>

        </div>

    </main>

</div>

<!-- FIN DES NOUVEAUX ESPACES -->


<div class="stadium-3d">

