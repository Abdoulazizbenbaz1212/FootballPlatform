<style>

.quick-section,
.content-section,
.community-section {
    max-width: 1100px;
    margin: 30px auto;
    padding: 0 20px;
}

.section-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 18px;
}

.section-title h2 {
    font-size: 22px;
}

.section-title span {
    display: block;
    color: var(--muted);
    font-size: 13px;
    margin-top: 4px;
}

.section-title a {
    color: var(--primary);
    text-decoration: none;
    font-weight: 700;
    white-space: nowrap;
}

.quick-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
}

.quick-card {
    text-decoration: none;
    color: var(--text);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    box-shadow: var(--shadow);
    transition: .2s;
}

.quick-card:hover {
    transform: translateY(-4px);
}

.quick-card span {
    display: block;
    font-size: 30px;
    margin-bottom: 15px;
}

.quick-card strong,
.quick-card small {
    display: block;
}

.quick-card small {
    color: var(--muted);
    margin-top: 5px;
}

.news-card {
    display: grid;
    grid-template-columns: 260px 1fr;
    overflow: hidden;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
}

.news-image {
    min-height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 70px;
    background: #eaf2ff;
}

.news-content {
    padding: 28px;
}

.news-category {
    color: var(--primary);
    font-size: 12px;
    font-weight: 800;
}

.news-content h3 {
    font-size: 25px;
    margin: 10px 0;
}

.news-content p {
    color: var(--muted);
    line-height: 1.6;
}

.news-meta {
    margin-top: 18px;
    font-size: 13px;
    color: var(--muted);
}

.match-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
}

.match-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    box-shadow: var(--shadow);
}

.match-card > span {
    color: var(--success);
    font-size: 12px;
    font-weight: 800;
}

.teams {
    display: flex;
    align-items: center;
    justify-content: space-around;
    text-align: center;
    margin: 25px 0;
}

.teams strong {
    font-size: 30px;
}

.teams p {
    margin-top: 6px;
    font-weight: 700;
}

.teams b {
    color: var(--muted);
}

.match-card small {
    color: var(--muted);
}

.game-banner {
    max-width: 1100px;
    margin: 35px auto;
    padding: 35px;
    border-radius: 22px;
    background: #111827;
    color: white;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
}

.game-banner span {
    font-size: 12px;
    font-weight: 800;
}

.game-banner h2 {
    font-size: 30px;
    margin: 8px 0;
}

.game-banner p {
    opacity: .75;
    line-height: 1.5;
}

.game-banner a,
.community-section a {
    display: inline-block;
    padding: 13px 18px;
    border-radius: 12px;
    background: var(--primary);
    color: white;
    text-decoration: none;
    font-weight: 800;
    white-space: nowrap;
}

.community-section {
    text-align: center;
    padding-top: 30px;
    padding-bottom: 120px;
}

.community-section p {
    max-width: 600px;
    margin: 10px auto 20px;
    color: var(--muted);
    line-height: 1.6;
}

@media (max-width: 700px) {

    .quick-section,
    .content-section,
    .community-section {
        margin: 22px auto;
        padding: 0 12px;
    }

    .quick-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }

    .quick-card {
        padding: 16px;
    }

    .quick-card span {
        font-size: 25px;
        margin-bottom: 10px;
    }

    .news-card {
        grid-template-columns: 1fr;
    }

    .news-image {
        min-height: 150px;
    }

    .news-content {
        padding: 20px;
    }

    .news-content h3 {
        font-size: 21px;
    }

    .match-grid {
        grid-template-columns: 1fr;
    }

    .game-banner {
        margin: 25px 12px;
        padding: 25px 20px;
        flex-direction: column;
        align-items: flex-start;
    }

    .game-banner h2 {
        font-size: 24px;
    }

    .section-title {
        align-items: flex-start;
    }

    .section-title > a {
        font-size: 12px;
    }
}

</style>


