<script src="{{ url_for('static', filename='js/game/shot-controller.js') }}"></script>

<script>
document.addEventListener(
    "DOMContentLoaded",
    () => {
        if (window.ShotController) {
            window.ShotController.init();
        }
    }
);
</script>

<script src="{{ url_for('static', filename='js/game/shot-match.js') }}"></script>

<script>
document.addEventListener(
    "DOMContentLoaded",
    () => {
        if (window.ShotMatch) {
            window.ShotMatch.init();
        }
    }
);
</script>

<script>
document.addEventListener("DOMContentLoaded", function () {

    const spaces = {
        home: document.getElementById("spaceHome"),
        game: document.getElementById("spaceGame"),
        videos: document.getElementById("spaceVideos"),
        news: document.getElementById("spaceNews")
    };

    function showSpace(name) {

        Object.values(spaces).forEach(function (space) {
            if (space) {
                space.classList.remove("active");
            }
        });

        if (spaces[name]) {
            spaces[name].classList.add("active");
        }

        window.scrollTo({
            top: 0,
            behavior: "smooth"
        });
    }

    document.addEventListener("click", function (event) {

        const button = event.target.closest("[data-space]");

        if (!button) {
            return;
        }

        showSpace(button.dataset.space);

    });

    window.FootballPlatformSpaces = {
        show: showSpace
    };

});
</script>
