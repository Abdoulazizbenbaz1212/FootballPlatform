    <div class="stadium-overlay"></div>

    <div class="hero-3d-content">

        <div class="hero-badge">
            ⚽ FOOTBALL PLATFORM
        </div>

        <h1>
            Le football
            <span>sans frontières.</span>
        </h1>

        <p>
            Actualités, matchs, joueurs,
            légendes et communauté.
        </p>

        <div class="hero-buttons">

            <a href="#players" class="btn-primary">
                Explorer le football
            </a>

            <a href="#matches" class="btn-secondary">
                Voir les matchs
            </a>

        </div>

    </div>

</div>


<header class="topbar">

