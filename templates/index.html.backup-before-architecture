            </div>


            <div class="match-card">

                <span>À venir</span>

                <div class="teams">

                    <div>
                        <strong>🔴</strong>
                        <p>Équipe C</p>
                    </div>

                    <b>VS</b>

                    <div>
                        <strong>🔵</strong>
                        <p>Équipe D</p>
                    </div>

                </div>

                <small>🕐 21:00</small>

            </div>

        </div>

    </section>


    <!-- JEUX -->
    <section class="game-banner">

        <div>

            <span>🎮 FOOTBALL GAMING</span>

            <h2>
                Teste tes connaissances
                football !
            </h2>

